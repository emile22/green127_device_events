# Current native environment uses Ubuntu apt packages, not source checkouts.
# Exact upstream commits cannot be recovered from installed binaries.
INSTALL_METHOD="apt-pinned"
WSL_DISTRIBUTION="Ubuntu-22.04"
WSL_RELEASE="22.04"
INSTALL_PREFIX="/usr"
SYSREPO_REPOSITORY="/etc/sysrepo"

LIBYANG_VERSION="2.0.112"
LIBYANG_PACKAGE="libyang2=2.0.112-6ubuntu2"
LIBYANG_COMMIT="NOT_RECOVERABLE_APT_INSTALL"
LIBNETCONF2_VERSION="2.0.24"
LIBNETCONF2_PACKAGE="libnetconf2-2=2.0.24-3build1"
LIBNETCONF2_COMMIT="NOT_RECOVERABLE_APT_INSTALL"
SYSREPO_VERSION="2.0.53"
SYSREPO_PACKAGE="sysrepo=2.0.53-6build1"
SYSREPO_COMMIT="NOT_RECOVERABLE_APT_INSTALL"
NETOPEER2_VERSION="2.0.35"
NETOPEER2_PACKAGE="netopeer2=2.0.35-1ubuntu1"
NETOPEER2_COMMIT="NOT_RECOVERABLE_APT_INSTALL"

CMAKE_STATUS="NOT_INSTALLED_NOT_REQUIRED_FOR_APT_STACK_OR_PLUGIN_BUILD"
LIBNETCONF2_PKG_CONFIG="UNAVAILABLE; use dpkg package version and ldd"
APT_REPOSITORY_SNAPSHOT="NOT_RECOVERABLE; current Ubuntu 22.04 configured repositories"
